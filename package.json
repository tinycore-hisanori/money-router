{
  "name": "money-router",
  "version": "1.0.0",
  "description": "Money Router — an AI radar for PayPal-payable work, worldwide. Collect, vet, route, verify.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "npm --prefix client run dev",
    "build": "npm run stamp && npm --prefix client run build && tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "crawl": "tsx src/crawler/cli.ts",
    "discover": "tsx src/crawler/discover-cli.ts",
    "radar": "tsx src/crawler/radar-cli.ts",
    "seed": "tsx scripts/make-seed.ts",
    "seed:payments": "tsx scripts/seed-payments.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm --prefix client run typecheck",
    "postinstall": "npm --prefix client install",
    "stamp": "node scripts/stamp-version.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "dotenv": "^16.4.5",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
