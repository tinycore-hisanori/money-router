# ---- Server ----
PORT=3000
DATA_DIR=./data/runtime

# ---- Anthropic (Claude API) ----
ANTHROPIC_API_KEY=
# Per-stage default models (any Claude model ID)
MODEL_EXTRACT=claude-sonnet-5-5
MODEL_AUDIT=claude-sonnet-5-5
MODEL_MATCH=claude-opus-5-5
MODEL_EXPLAIN=claude-opus-5-5
# Weekday audit schedule. Format: <dow>:<model>:<full|diff>,...
# Days not listed use MODEL_AUDIT in diff mode (only changed pages are re-audited).
AUDIT_SCHEDULE=mon:claude-fable-5-1:full,thu:claude-opus-5-5:full

# ---- PayPal (sandbox only) ----
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Account A = the Money Router user (owner of the app above). Transaction Search reads this account.
PAYPAL_RECEIVER_EMAIL=
# Account B = demo payer ("CrazyGames" etc.). A second sandbox Business account with its own app ("Money Router Seeder").
# Used only by `npm run seed:payments`. Leave empty if you don't need demo payouts.
PAYPAL_SEED_CLIENT_ID=
PAYPAL_SEED_CLIENT_SECRET=

# ---- Brave Search (Source Discovery; free plan is enough) ----
BRAVE_SEARCH_API_KEY=
DISCOVERY_MAX_QUERIES_PER_RUN=50

# ---- Crawler ----
# mock = use data/opportunities.seed.json without network or LLM calls
CRAWLER_MODE=mock
# Daily in-process crawl time (UTC hour, 0-23). Empty = disabled (use `npm run crawl` or POST /api/crawl)
CRAWL_HOUR_UTC=3
# Shared secret for POST /api/crawl?token=... (manual trigger)
CRAWL_TOKEN=
CRAWLER_USER_AGENT=MoneyRouterBot/1.0 (+https://github.com/tinycore-hisanori/money-router)
